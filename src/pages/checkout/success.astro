
---
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,follow" />
  <title>Order Confirmation | Vahako</title>
</head>

<body>
  <Header />

  <main class="success-page">
    <section id="loading" class="confirmation-card">
      <p>Loading your order confirmation...</p>
    </section>

    <section id="confirmation" class="confirmation-card" hidden>
      <div class="success-icon" aria-hidden="true">✓</div>

      <h1>Order Received Successfully!</h1>

      <p class="intro">
        Thank you for choosing Vahako. Your order has been received
        and is awaiting confirmation by our team.
      </p>

      <div class="order-number-box">
        <span>Your Order Number</span>
        <strong id="orderNumber"></strong>
      </div>

      <div class="order-details">
        <div class="detail-row">
          <span>Customer</span>
          <strong id="customerName"></strong>
        </div>

        <div class="detail-row">
          <span>Product Total</span>
          <strong id="productTotal"></strong>
        </div>

        <div class="detail-row">
          <span>Order Status</span>
          <strong id="orderStatus">Pending Confirmation</strong>
        </div>

        <div class="detail-row">
          <span>Payment Status</span>
          <strong id="paymentStatus">Unpaid</strong>
        </div>

        <div class="detail-row">
          <span>Delivery Charges</span>
          <strong>To Be Confirmed</strong>
        </div>
      </div>

      <div class="information-box">
        <h2>What Happens Next?</h2>

        <p>
          Our team will review your order and contact you to confirm
          product specifications, availability, delivery charges
          and payment arrangements.
        </p>

        <p>
          <strong>No payment has been collected.</strong>
          Please wait for confirmation from our team before making
          any payment.
        </p>
      </div>

      <div class="action-buttons">
        <a href="/shop/" class="primary-button">
          Continue Shopping
        </a>

        <a href="/" class="secondary-button">
          Back to Home
        </a>
      </div>

      <p class="reference-note">
        Please keep your order number for future reference.
      </p>
    </section>

    <section id="noConfirmation" class="confirmation-card" hidden>
      <h1>No Order Confirmation Found</h1>

      <p class="intro">
        We could not find an order confirmation in this browser session.
        If you recently submitted an order, please contact Vahako
        before submitting it again.
      </p>

      <a href="/shop/" class="primary-button">
        Return to Shop
      </a>
    </section>
  </main>
</body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f8fafc;
    color: #172033;
  }

  .success-page,
  .success-page * {
    box-sizing: border-box;
  }

  .success-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 135px 20px 85px;
    min-height: 80vh;
  }

  [hidden] {
    display: none !important;
  }

  .confirmation-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 40px;
    text-align: center;
    box-shadow: 0 12px 35px rgba(15, 23, 42, 0.04);
  }

  .success-icon {
    width: 76px;
    height: 76px;
    background: #dcfce7;
    color: #15803d;
    border-radius: 50%;
    margin: 0 auto 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    font-weight: 800;
  }

  h1 {
    font-size: clamp(26px, 4vw, 36px);
    margin: 0 0 16px;
    color: #172033;
  }

  .intro {
    color: #64748b;
    font-size: 15px;
    line-height: 1.8;
    max-width: 560px;
    margin: 0 auto 30px;
  }

  .order-number-box {
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    padding: 24px 15px;
    margin-bottom: 30px;
  }

  .order-number-box span {
    display: block;
    color: #64748b;
    font-size: 13px;
    margin-bottom: 10px;
  }

  .order-number-box strong {
    display: block;
    font-size: clamp(17px, 3.5vw, 25px);
    font-weight: 800;
    color: #c51e2b;
    overflow-wrap: anywhere;
  }

  .order-details {
    text-align: left;
    margin-bottom: 30px;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding: 16px 5px;
    border-bottom: 1px solid #e5e7eb;
    font-size: 14px;
  }

  .detail-row span {
    color: #64748b;
  }

  .detail-row strong {
    text-align: right;
    overflow-wrap: anywhere;
  }

  .information-box {
    background: #f1f5f9;
    border-radius: 12px;
    padding: 25px;
    text-align: left;
    margin-bottom: 30px;
  }

  .information-box h2 {
    font-size: 19px;
    margin: 0 0 15px;
  }

  .information-box p {
    font-size: 14px;
    color: #475569;
    line-height: 1.8;
    margin: 10px 0;
  }

  .action-buttons {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 15px 24px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    min-width: 175px;
  }

  .primary-button {
    background: #c51e2b;
    color: #ffffff;
  }

  .primary-button:hover {
    background: #a51823;
  }

  .secondary-button {
    background: #ffffff;
    color: #172033;
    border: 1px solid #cbd5e1;
  }

  .reference-note {
    color: #94a3b8;
    font-size: 12px;
    margin: 25px 0 0;
  }

  @media (max-width: 600px) {
    .success-page {
      padding: 115px 15px 50px;
    }

    .confirmation-card {
      padding: 25px 18px;
    }

    .information-box {
      padding: 20px;
    }

    .action-buttons {
      flex-direction: column;
    }

    .primary-button,
    .secondary-button {
      width: 100%;
    }
  }
</style>

<script>
  import { clearBasket } from '../../lib/basket';

  type ConfirmedOrder = {
    orderNumber: string;
    productTotal: number;
    orderStatus: string;
    paymentStatus: string;
    customerName: string;
  };

  const confirmedKey = 'vahako-confirmed-order';

  const loading = document.querySelector<HTMLElement>('#loading');
  const confirmation = document.querySelector<HTMLElement>('#confirmation');
  const noConfirmation = document.querySelector<HTMLElement>('#noConfirmation');

  const money = (value: number) =>
    new Intl.NumberFormat('en-LK', {
      style: 'currency',
      currency: 'LKR',
      maximumFractionDigits: 0
    }).format(value);

  function showNoConfirmation() {
    if (loading) loading.hidden = true;
    if (noConfirmation) noConfirmation.hidden = false;
  }

  try {
    const raw = sessionStorage.getItem(confirmedKey);

    if (!raw) {
      showNoConfirmation();
    } else {
      const order = JSON.parse(raw) as ConfirmedOrder;

      if (
        !order ||
        typeof order.orderNumber !== 'string' ||
        !/^VH-[A-Za-z0-9-]+$/.test(order.orderNumber) ||
        typeof order.productTotal !== 'number' ||
        !Number.isFinite(order.productTotal) ||
        order.productTotal < 0
      ) {
        showNoConfirmation();
      } else {
        const number = document.querySelector<HTMLElement>('#orderNumber');
        const customer = document.querySelector<HTMLElement>('#customerName');
        const total = document.querySelector<HTMLElement>('#productTotal');
        const orderStatus = document.querySelector<HTMLElement>('#orderStatus');
        const paymentStatus = document.querySelector<HTMLElement>('#paymentStatus');

        if (number) number.textContent = order.orderNumber;
        if (customer) customer.textContent = order.customerName || '';
        if (total) total.textContent = money(order.productTotal);
        if (orderStatus) orderStatus.textContent = order.orderStatus || 'Pending Confirmation';
        if (paymentStatus) paymentStatus.textContent = order.paymentStatus || 'Unpaid';

        // Only clear the basket after a confirmed successful API response.
        // The review page writes this confirmation data after success.
        clearBasket();

        sessionStorage.removeItem('vahako-checkout-details');
        sessionStorage.removeItem('vahako-pending-order');

        if (loading) loading.hidden = true;
        if (confirmation) confirmation.hidden = false;
      }
    }
  } catch (error) {
    console.error('Unable to load order confirmation:', error);
    showNoConfirmation();
  }
</script>
