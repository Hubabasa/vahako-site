
---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import FloatingContact from '../../components/FloatingContact.astro';
import { getAllCategories } from '../../lib/categories';

const products = (await getCollection('products'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const categories = await getAllCategories();

// Manually selected shop categories.
// Change the slugs or their order whenever required.
const featuredCategorySlugs = [
  'stainless-steel-fabrications-in-sri-lanka',
  'household-sink-in-sri-lanka',
  'industrial-sinks-in-sri-lanka',
  'dairy-processing-equipment-in-sri-lanka',
  'milk-boiling-stands-in-sri-lanka',
  // Add up to 3 more category slugs here.
];

// Show only selected categories, in the exact order above.
const featuredCategories = featuredCategorySlugs
  .slice(0, 8)
  .map((slug) =>
    categories.find((category) => category.slug === slug)
  )
  .filter((category) => category !== undefined);

const money = (value: number, currency: string) =>
  new Intl.NumberFormat('en-LK', {
    style: 'currency',
    currency,
    maximumFractionDigits: 0,
  }).format(value);

const title = 'Fabrication Products & Equipment in Sri Lanka | Vahako';
const description =
  'Explore fabrication products, stainless steel equipment, commercial kitchen solutions and custom-made products in Sri Lanka. Browse the Vahako catalog and request quotations.';

const canonical = 'https://vahako.com/shop/';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
</head>

<body>
  <Header />

  <main class="shop-page">

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span aria-current="page">Shop</span>
    </nav>

    <section class="shop-hero">
      <div class="hero-content">
        <p class="eyebrow">VAHAKO PRODUCT CATALOG</p>

        <h1>Fabrication Products & Equipment in Sri Lanka</h1>

        <p class="hero-description">
          Explore stainless steel products, commercial equipment,
          industrial solutions and custom fabrication products.
          Find the right solution for your project.
        </p>

        <div class="search-wrap">
          <label class="sr-only" for="shop-search">
            Search products
          </label>

          <input
            id="shop-search"
            type="search"
            placeholder="Search products, sinks, racks, equipment..."
            autocomplete="off"
          />
          <span class="search-icon" aria-hidden="true">⌕</span>
        </div>

        <p class="search-hint">
          Search products by name or description.
        </p>
      </div>
    </section>

    <section class="shop-section categories-section" aria-labelledby="categories-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">DISCOVER</p>
          <h2 id="categories-title">Shop by Category</h2>
          <p>Explore products organized by fabrication type and application.</p>
        </div>
      </div>

      <div class="category-grid">
        {featuredCategories.map((category) => (
          <a class="category-card" href={`/category/${category.slug}/`}>
            <div class="category-image">
              {category.image ? (
                <img
                  src={category.image}
                  alt=""
                  width="400"
                  height="260"
                  loading="lazy"
                  decoding="async"
                />
              ) : category.products[0]?.data.image ? (
                <img
                  src={category.products[0].data.image}
                  alt=""
                  width="400"
                  height="260"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="category-placeholder" aria-hidden="true">◇</span>
              )}
            </div>

            <div class="category-info">
              <h3>{category.name}</h3>
              <span>{category.products.length} products</span>
            </div>
          </a>
        ))}
      </div>

      {categories.length > featuredCategories.length && (
        <details class="all-categories">
          <summary>Browse All Categories</summary>

          <div class="all-category-links">
            {categories.map((category) => (
              <a href={`/category/${category.slug}/`}>
                {category.name}
              </a>
            ))}
          </div>
        </details>
      )}
    </section>

    <section class="shop-section products-section" aria-labelledby="products-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">OUR COLLECTION</p>
          <h2 id="products-title">Explore Our Products</h2>
          <p>Browse available products and made-to-order fabrication solutions.</p>
        </div>

        <span class="product-count" id="product-count">
          {products.length} products
        </span>
      </div>

      <p class="no-results" id="no-results" hidden>
        No products match your search.
      </p>

      <div class="product-grid" id="product-grid">
        {products.map((product) => (
          <a
            class="product-card"
            href={`/shop/${product.id}/`}
            data-search={`${product.data.title} ${product.data.description} ${product.data.categories.join(' ')}`.toLowerCase()}
          >
            <div class="product-image">
              <img
                src={product.data.image}
                alt={product.data.title}
                width="500"
                height="500"
                loading="lazy"
                decoding="async"
              />

              {product.data.salePrice !== undefined && (
                <span class="sale-badge">SALE</span>
              )}
            </div>

            <div class="product-info">
              <p class="product-category">{product.data.primaryCategory}</p>
              <h3>{product.data.title}</h3>
              <p class="product-description">{product.data.description}</p>

              <div class="product-bottom">
                <div class="price">
                  {product.data.priceOnRequest ? (
                    <strong>Price on Request</strong>
                  ) : product.data.salePrice !== undefined ? (
                    <>
                      <strong>{money(product.data.salePrice, product.data.currency)}</strong>
                      <del>{money(product.data.price, product.data.currency)}</del>
                    </>
                  ) : (
                    <strong>{money(product.data.price, product.data.currency)}</strong>
                  )}
                </div>

                <span class="view-product">View Product ↗</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="shop-cta">
      <div>
        <p class="section-kicker">CUSTOM FABRICATION</p>
        <h2>Need Something Made to Your Specifications?</h2>
        <p>
          Contact Vahako to discuss custom dimensions, materials,
          fabrication requirements and project quotations.
        </p>
      </div>

      <a
        href="https://wa.me/94703336339?text=Hello%20Vahako%2C%20I%20would%20like%20to%20discuss%20a%20custom%20fabrication%20project."
        target="_blank"
        rel="noopener noreferrer"
        class="cta-button"
      >
        Discuss Your Project ↗
      </a>
    </section>

  </main>

  <FloatingContact
    pageName="Vahako Shop"
    whatsappMessage={`Hello Vahako, I am browsing your product catalog. ${canonical}`}
    quotePage="Vahako Shop"
  />

  <script>
    const input = document.querySelector<HTMLInputElement>('#shop-search');
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.product-card')
    );
    const count = document.querySelector<HTMLElement>('#product-count');
    const noResults = document.querySelector<HTMLElement>('#no-results');

    input?.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const matches = (card.dataset.search ?? '').includes(query);
        card.hidden = !matches;
        if (matches) visible++;
      }

      if (count) count.textContent = `${visible} products`;
      if (noResults) noResults.hidden = visible !== 0;
    });
  </script>
</body>
</html>

<style>
  :global(html) {
    overflow-x: clip;
  }

  :global(body) {
    margin: 0;
    background: #fff;
    color: #17212b;
    font-family: Arial, Helvetica, sans-serif;
  }

  .shop-page,
  .shop-page * {
    box-sizing: border-box;
  }

  .shop-page {
    max-width: 1240px;
    margin: auto;
    padding: 105px 24px 75px;
  }

  .breadcrumbs {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
    font-size: 13px;
    color: #777;
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .shop-hero {
    padding: 65px 55px;
    background: linear-gradient(125deg, #17252b, #253a43);
    color: #fff;
    border-radius: 20px;
  }

  .hero-content {
    max-width: 820px;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 14px;
    color: #c51e2b;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .shop-hero .eyebrow {
    color: #e5bd7c;
  }

  .shop-hero h1 {
    margin: 0 0 20px;
    font-size: clamp(32px, 4.5vw, 55px);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .hero-description {
    margin: 0 0 28px;
    color: #d6e0e5;
    font-size: 16px;
    line-height: 1.8;
  }

  .search-wrap {
    position: relative;
    max-width: 650px;
  }

  .search-wrap input {
    width: 100%;
    padding: 18px 48px 18px 20px;
    border: 1px solid #dce2e6;
    border-radius: 10px;
    background: #fff;
    color: #17212b;
    font-size: 16px;
    outline-offset: 3px;
  }

  .search-icon {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #64748b;
    font-size: 30px;
    pointer-events: none;
  }

  .search-hint {
    margin: 12px 0 0;
    font-size: 12px;
    color: #c6d2d8;
  }

  .shop-section {
    padding-top: 65px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .section-heading h2 {
    margin: 0 0 10px;
    font-size: clamp(27px, 3vw, 36px);
    letter-spacing: -0.025em;
  }

  .section-heading p:last-child {
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 1.6;
  }

  .category-grid,
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
  }

  .category-card,
  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e8edf0;
    border-radius: 14px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s;
  }

  .category-card:hover,
  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,.07);
  }

  .category-image {
    height: 155px;
    background: #f4f6f7;
    overflow: hidden;
  }

  .category-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 50px;
    color: #a1a1aa;
  }

  .category-info {
    padding: 16px;
  }

  .category-info h3 {
    margin: 0 0 8px;
    font-size: 16px;
    line-height: 1.4;
  }

  .category-info span {
    color: #64748b;
    font-size: 12px;
  }

  .all-categories {
    margin-top: 24px;
  }

  .all-categories summary {
    display: inline-block;
    cursor: pointer;
    padding: 12px 18px;
    border: 1px solid #dce2e6;
    border-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    list-style: none;
  }

  .all-category-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 20px;
  }

  .all-category-links a {
    padding: 10px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    color: #334155;
    text-decoration: none;
    font-size: 13px;
  }

  .all-category-links a:hover {
    border-color: #c51e2b;
    color: #c51e2b;
  }

  .product-count {
    white-space: nowrap;
    color: #64748b;
    font-size: 13px;
  }

  .product-image {
    position: relative;
    aspect-ratio: 1;
    background: #f7f7f7;
    overflow: hidden;
  }

  .product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sale-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #c51e2b;
    color: #fff;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 800;
  }

  .product-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 17px;
  }

  .product-category {
    margin: 0 0 8px;
    color: #64748b;
    font-size: 12px;
  }

  .product-info h3 {
    margin: 0 0 12px;
    font-size: 17px;
    line-height: 1.4;
  }

  .product-description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0 0 18px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.6;
  }

  .product-bottom {
    margin-top: auto;
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 15px;
    color: #c51e2b;
    font-size: 17px;
  }

  .price del {
    color: #94a3b8;
    font-size: 12px;
  }

  .view-product {
    font-size: 13px;
    font-weight: 700;
  }

  .no-results {
    padding: 20px;
    background: #f8fafc;
    border-radius: 10px;
    color: #64748b;
  }

  .shop-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    margin-top: 75px;
    padding: 40px;
    border-radius: 18px;
    background: #f4f6f7;
  }

  .shop-cta h2 {
    margin: 0 0 12px;
    font-size: clamp(24px, 3vw, 34px);
  }

  .shop-cta p:not(.section-kicker) {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .cta-button {
    flex-shrink: 0;
    padding: 15px 22px;
    border-radius: 9px;
    background: #c51e2b;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
  }

  .cta-button:hover {
    background: #a91a25;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 1000px) {
    .category-grid,
    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 750px) {
    .shop-page {
      padding: 95px 16px 55px;
    }

    .shop-hero {
      padding: 36px 23px;
      border-radius: 14px;
    }

    .shop-section {
      padding-top: 45px;
    }

    .category-grid,
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 13px;
    }

    .category-image {
      height: 115px;
    }

    .category-info,
    .product-info {
      padding: 13px;
    }

    .category-info h3,
    .product-info h3 {
      font-size: 14px;
    }

    .shop-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 25px;
      margin-top: 55px;
    }
  }

  @media (max-width: 420px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .product-card {
      transition: none;
    }
  }
</style>
