
---
import Header from '../../components/Header.astro';
import FloatingContact from '../../components/FloatingContact.astro';
import { getAllCategories } from '../../lib/categories';

const categories = await getAllCategories();

const sortedCategories = [...categories].sort((a, b) =>
  a.name.localeCompare(b.name, 'en', { sensitivity: 'base' })
);

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

const letters = new Set(
  sortedCategories.map((category) =>
    category.name.charAt(0).toUpperCase()
  )
);

const title = 'Product Categories in Sri Lanka | Vahako';
const description =
  'Browse Vahako product categories in Sri Lanka, including stainless steel fabrications, commercial kitchen equipment, machinery and custom fabrication solutions.';

const canonical = 'https://vahako.com/categories/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>

  <body>
    <Header />

    <main class="directory-page">

      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/shop/">Shop</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Categories</span>
      </nav>

      <header class="directory-header">
        <p class="eyebrow">VAHAKO PRODUCT DIRECTORY</p>

        <h1>Browse All Product Categories</h1>

        <p class="directory-description">
          Explore fabrication products, machinery, stainless steel
          equipment and custom-made solutions in Sri Lanka.
          Find the right category for your project.
        </p>

        <div class="directory-search">
          <label for="category-search" class="sr-only">
            Search product categories
          </label>

          <svg
            aria-hidden="true"
            width="21"
            height="21"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>

          <input
            id="category-search"
            type="search"
            placeholder="Search categories..."
            autocomplete="off"
          />
        </div>

        <div class="directory-stats">
          <span id="category-count">
            {sortedCategories.length} categories
          </span>

          <span class="stats-divider" aria-hidden="true">•</span>

          <span>Fabrication & Equipment</span>
        </div>
      </header>

      <section
        class="directory-content"
        aria-labelledby="directory-title"
      >
        <div class="section-heading">
          <div>
            <p class="section-kicker">EXPLORE</p>
            <h2 id="directory-title">All Categories</h2>
          </div>

          <a href="/shop/" class="back-shop">
            Browse Products <span aria-hidden="true">↗</span>
          </a>
        </div>

        <nav
          class="alphabet-nav"
          aria-label="Browse categories alphabetically"
          id="alphabet-nav"
        >
          {alphabet.map((letter) =>
            letters.has(letter) ? (
              <a href={`#letter-${letter}`}>
                {letter}
              </a>
            ) : (
              <span class="letter-disabled" aria-disabled="true">
                {letter}
              </span>
            )
          )}
        </nav>

        <p class="no-results" id="no-results" hidden>
          No categories match your search. Try a different keyword.
        </p>

        <div class="category-groups">
          {alphabet
            .filter((letter) => letters.has(letter))
            .map((letter) => {
              const group = sortedCategories.filter(
                (category) =>
                  category.name.charAt(0).toUpperCase() === letter
              );

              return (
                <section
                  class="category-group"
                  id={`letter-${letter}`}
                >
                  <div class="group-heading">
                    <span class="group-letter">{letter}</span>
                    <span class="group-count">
                      {group.length} categories
                    </span>
                  </div>

                  <div class="category-grid">
                    {group.map((category) => (
                      <a
                        class="category-card"
                        href={`/category/${category.slug}/`}
                        data-search={category.name.toLowerCase()}
                      >
                        <div class="category-card-content">
                          <h3>{category.name}</h3>

                          <span class="product-count">
                            {category.products.length}
                            {' '}
                            {category.products.length === 1
                              ? 'product'
                              : 'products'}
                          </span>
                        </div>

                        <span
                          class="category-arrow"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      </a>
                    ))}
                  </div>
                </section>
              );
            })}
        </div>
      </section>

      <section class="directory-cta">
        <div>
          <h2>Can't Find What You're Looking For?</h2>
          <p>
            Vahako provides custom fabrication solutions.
            Contact our team to discuss your specific requirements.
          </p>
        </div>

        <a href="/get-quote/" class="cta-button">
          Request a Quotation
          <span aria-hidden="true">↗</span>
        </a>
      </section>

    </main>

    <FloatingContact
      pageName="Vahako Product Categories"
      whatsappMessage={`Hello Vahako, I am browsing your product categories. ${canonical}`}
      quotePage="Vahako Product Categories"
    />

    <script>
      const searchInput =
        document.querySelector<HTMLInputElement>('#category-search');

      const categoryCards = Array.from(
        document.querySelectorAll<HTMLElement>('.category-card')
      );

      const categoryGroups = Array.from(
        document.querySelectorAll<HTMLElement>('.category-group')
      );

      const countElement =
        document.querySelector<HTMLElement>('#category-count');

      const noResults =
        document.querySelector<HTMLElement>('#no-results');

      const alphabetNav =
        document.querySelector<HTMLElement>('#alphabet-nav');

      searchInput?.addEventListener('input', () => {
        const query = searchInput.value.trim().toLowerCase();

        let visibleCount = 0;

        for (const card of categoryCards) {
          const matches =
            (card.dataset.search ?? '').includes(query);

          card.hidden = !matches;

          if (matches) visibleCount++;
        }

        for (const group of categoryGroups) {
          const hasVisibleCards = Array.from(
            group.querySelectorAll<HTMLElement>('.category-card')
          ).some((card) => !card.hidden);

          group.hidden = !hasVisibleCards;
        }

        if (countElement) {
          countElement.textContent =
            `${visibleCount} categories`;
        }

        if (noResults) {
          noResults.hidden = visibleCount !== 0;
        }

        if (alphabetNav) {
          alphabetNav.hidden = query.length > 0;
        }
      });
    </script>
  </body>
</html>

<style>
  :global(html) {
    width: 100%;
    overflow-x: clip;
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    width: 100%;
    overflow-x: clip;
    font-family: Arial, Helvetica, sans-serif;
    background: #fff;
    color: #17212b;
  }

  .directory-page,
  .directory-page * {
    box-sizing: border-box;
  }

  .directory-page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 115px 24px 85px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 38px;
    color: #777;
    font-size: 13px;
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #c51e2b;
  }

  .directory-header {
    max-width: 850px;
    margin-bottom: 65px;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 14px;
    color: #c51e2b;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .directory-header h1 {
    margin: 0 0 20px;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: #171717;
  }

  .directory-description {
    max-width: 730px;
    margin: 0 0 30px;
    color: #596575;
    font-size: 17px;
    line-height: 1.8;
  }

  .directory-search {
    display: flex;
    align-items: center;
    gap: 13px;
    max-width: 620px;
    padding: 0 18px;
    border: 1px solid #dce2e6;
    border-radius: 12px;
    background: #fff;
    color: #64748b;
    transition: border-color .2s;
  }

  .directory-search:focus-within {
    border-color: #c51e2b;
  }

  .directory-search svg {
    flex-shrink: 0;
  }

  .directory-search input {
    width: 100%;
    min-width: 0;
    height: 58px;
    border: 0;
    outline: 0;
    background: transparent;
    color: #17212b;
    font-size: 16px;
  }

  .directory-search input::placeholder {
    color: #94a3b8;
  }

  .directory-stats {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    color: #64748b;
    font-size: 13px;
  }

  .stats-divider {
    color: #cbd5e1;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 28px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(27px, 3vw, 36px);
    letter-spacing: -0.025em;
  }

  .back-shop {
    color: #c51e2b;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .back-shop:hover {
    text-decoration: underline;
  }

  .alphabet-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 45px;
    padding: 18px;
    border-radius: 12px;
    background: #f8fafc;
  }

  .alphabet-nav a,
  .alphabet-nav span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 33px;
    height: 36px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .alphabet-nav a {
    color: #334155;
    background: #fff;
    border: 1px solid #e5e7eb;
  }

  .alphabet-nav a:hover {
    color: #fff;
    background: #c51e2b;
    border-color: #c51e2b;
  }

  .letter-disabled {
    color: #cbd5e1;
  }

  .category-group {
    margin-bottom: 45px;
    scroll-margin-top: 100px;
  }

  .group-heading {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e5e7eb;
  }

  .group-letter {
    font-size: 30px;
    font-weight: 800;
    color: #c51e2b;
  }

  .group-count {
    color: #94a3b8;
    font-size: 12px;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .category-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    min-width: 0;
    padding: 22px;
    border: 1px solid #e8edf0;
    border-radius: 12px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: border-color .2s, box-shadow .2s, transform .2s;
  }

  .category-card:hover {
    border-color: #c51e2b;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0,0,0,.05);
  }

  .category-card-content {
    min-width: 0;
  }

  .category-card h3 {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }

  .product-count {
    color: #64748b;
    font-size: 12px;
  }

  .category-arrow {
    flex-shrink: 0;
    color: #c51e2b;
    font-size: 22px;
  }

  .no-results {
    padding: 22px;
    border-radius: 10px;
    background: #f8fafc;
    color: #64748b;
    font-size: 15px;
  }

  .directory-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    margin-top: 70px;
    padding: 40px;
    border-radius: 18px;
    background: #f4f6f7;
  }

  .directory-cta h2 {
    margin: 0 0 12px;
    font-size: clamp(24px, 3vw, 32px);
  }

  .directory-cta p {
    max-width: 650px;
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .cta-button {
    flex-shrink: 0;
    padding: 15px 22px;
    border-radius: 9px;
    background: #c51e2b;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .cta-button:hover {
    background: #a91a25;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 950px) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 650px) {
    .directory-page {
      padding: 100px 16px 60px;
    }

    .directory-header {
      margin-bottom: 45px;
    }

    .directory-description {
      font-size: 15px;
    }

    .directory-search input {
      height: 52px;
    }

    .alphabet-nav {
      padding: 12px;
      gap: 5px;
    }

    .alphabet-nav a,
    .alphabet-nav span {
      width: 30px;
      height: 33px;
      font-size: 12px;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .category-card {
      padding: 18px;
    }

    .directory-cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 25px;
      margin-top: 50px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .category-card {
      transition: none;
    }
  }
</style>
